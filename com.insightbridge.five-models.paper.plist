<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.insightbridge.five-models.paper</string>

  <!-- launchd(后台)受 macOS TCC 限制无法打开 ~/Desktop 下的脚本(会 exit 127)，
       故直接调用 python3(有磁盘访问权)运行 .py，避免经由 zsh 打开 Desktop 下的包装脚本。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/anaconda3/bin/python3</string>
    <string>-u</string>
    <string>/Users/tongyin/Desktop/InsightBridge_Financial_Models_Latest/execution_framework/run_tws_continuous.py</string>
    <string>--live</string>
    <string>--port</string>
    <string>4002</string>
    <string>--symbols</string>
    <string>BTC,EURUSD,USDJPY,MES,MNQ,ZT,ZN,SR3</string>
    <string>--interval</string>
    <string>60</string>
    <string>--broker-source-of-truth</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/tongyin/Desktop/InsightBridge_Financial_Models_Latest</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/anaconda3/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONPATH</key>
    <string>/Users/tongyin/Desktop/InsightBridge_Financial_Models_Latest</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/tongyin/Library/Logs/InsightBridge/five_models_paper_launchd_stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/tongyin/Library/Logs/InsightBridge/five_models_paper_launchd_stderr.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
